{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "env": {
    "MONGODB_URI": "@MONGODB_URI",
    "GOOGLE_MAPS_API_KEY": "@GOOGLE_MAPS_API_KEY",
    "GEMINI_API_KEY": "@GEMINI_API_KEY"
  },
  "functions": {
    "backend/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
